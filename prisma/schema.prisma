datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(USER)
  phoneNumber       String?
  telegramHandle    String?
  fanNumber         String?
  nationalIdUrl     String?
  verificationState VerificationState? @default(UNVERIFIED)
  verifiedStatus    Boolean            @default(false)
  rating            Float              @default(0.0)
  listings          Listing[]
  reviewsWritten    Review[]           @relation("ReviewerReviews")
  reviewsReceived   Review[]           @relation("SellerReviews")
  buyerTx           Transaction[]      @relation("BuyerTransactions")
  sellerTx          Transaction[]      @relation("SellerTransactions")
  reports           Report[]
  createdAt         DateTime           @default(now())

  @@index([verifiedStatus])
}

model Report {
  id         String      @id @default(cuid())
  listingId  String
  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  @@index([listingId])
  @@index([status, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  icon     String?
  listings Listing[]
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  title        String
  description  String
  price        Float
  condition    Condition
  city         String
  neighborhood String
  status       ListingStatus @default(ACTIVE)
  photos       String[]      // Array of image URLs / data URIs
  transactions Transaction[]
  reports      Report[]
  createdAt    DateTime      @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([sellerId])
  @@index([price])
  @@index([city])
}

model Transaction {
  id                String            @id @default(cuid())
  listingId         String
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User              @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            User              @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  amount            Float
  paymentGatewayRef String?
  status            TransactionStatus @default(PENDING)
  reviews           Review[]
  createdAt         DateTime          @default(now())

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([listingId])
}

model Review {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User        @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@unique([transactionId, reviewerId])
  @@index([sellerId])
}

enum Role {
  USER
  ADMIN
}

enum VerificationState {
  UNVERIFIED
  IN_PROGRESS
  VERIFIED
  DECLINED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum Condition {
  BRAND_NEW
  LIKE_NEW
  LIGHTLY_USED
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}